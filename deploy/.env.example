# ─── Домен (для Caddy + Telegram deep-links) ─────────────────────
# На VPS возьмите свой IP, замените точки на дефисы:
#   VPS IP 203.0.113.45 → DOMAIN=203-0-113-45.sslip.io
DOMAIN=your-ip.sslip.io

# ─── Telegram bot ───────────────────────────────────────────────
# Получите токен у @BotFather, username — без @
BOT_TOKEN=
BOT_USERNAME=membership_bot
# ID приватного канала. Бот должен быть его админом с правом invite/ban.
PRIVATE_CHANNEL_ID=0
# Optional pre-created fallback invite for the community channel. Prefer bot-created
# one-time links when the bot has admin rights.
PRIVATE_CHANNEL_INVITE_LINK=
# Second launch Telegram resource: the hypnotherapist practice chat. Required in prod.
PRACTICE_CHAT_ID=0
# Optional pre-created fallback invite for the practice chat.
PRACTICE_CHAT_INVITE_LINK=
BOT_UPDATE_MODE=polling
# ─── GK-443: предзапусковая заглушка ─────────────────────────────
# true = бот отвечает на любое личное сообщение, команду и нажатие кнопки
# одним согласованным текстом и больше ничем: подписка, архив и поддержка не
# зарегистрированы вообще, счёт создать нельзя. Два расписания, которые пишут
# участникам (kick_expired, remind_expiring), пропускают запуск; служебные
# задачи и heartbeat продолжают работать.
#
# Включается тем же действием, которым бот возвращается в строй, и
# выключается на запуске. По умолчанию false: заглушка, включённая по
# умолчанию, — ловушка для всех будущих деплоев.
ENABLE_PRELAUNCH_HOLD=false
# GK-446. Кто проходит мимо заглушки: numeric Telegram user ids через запятую.
# Нужно, чтобы Грант и кураторы проверили финальные тексты на живом боте, пока
# участники видят заглушку. Только числовые id — @username меняется, и его
# нельзя разрешить до старта сессии бота.
#
# Пусто = никто, заглушка накрывает всех, и гарантия GK-443 не тронута.
# Непустой список возвращает в диспетчер все продающие хендлеры для этих id:
# они доходят до настоящей оплаты и могут реально заплатить. Это и есть смысл
# проверки, но это не «сухой прогон».
#   PRELAUNCH_HOLD_ALLOWLIST=111111111,222222222
PRELAUNCH_HOLD_ALLOWLIST=
# ─── GK-460: разрешение на почасовое удаление истёкших ───────────
# kick_expired_job раз в час удаляет (ban+unban) участников с истёкшим доступом
# из всех настроенных Telegram-ресурсов, без подтверждения и без присмотра.
# Раньше его сдерживал только ENABLE_PRELAUNCH_HOLD — то есть одна правка .env
# в день запуска одновременно и возвращала продажи, и вооружала удаление.
# Теперь это два отдельных решения.
#
# false = удаление по истечении не выполняется. Ретраи по ручным банам из
# админки продолжают работать: их уже назначил человек.
ENABLE_EXPIRY_REMOVALS=false
# Чаты, из которых оператор осознанно разрешает удалять, через запятую. Должны
# совпадать как множество с PRIVATE_CHANNEL_ID и PRACTICE_CHAT_ID — ровно, а не
# «хотя бы часть»: чат, который появился, но не назван, так же неожидан, как
# названный и потом перенастроенный. Аналог --expect-chats у
# `python -m app.ops.cutover`.
#
# Пусто при ENABLE_EXPIRY_REMOVALS=true = задача откажется работать и напишет
# об этом в ops-алерт: никто не удалён.
#   EXPIRY_REMOVALS_EXPECT_CHATS=-1001111111111,-1002222222222
EXPIRY_REMOVALS_EXPECT_CHATS=
# Keep empty to use PUBLIC_BASE_URL. Prod example:
#   TG_WEBHOOK_BASE_URL=https://community.example.com
TG_WEBHOOK_BASE_URL=
TG_WEBHOOK_PATH=/tg-webhook/bot
# Required when BOT_UPDATE_MODE=webhook. Generate with: openssl rand -hex 32
TG_WEBHOOK_SECRET=
TG_WEBHOOK_LISTEN_HOST=0.0.0.0
TG_WEBHOOK_LISTEN_PORT=8080

# ─── База + Redis ───────────────────────────────────────────────
POSTGRES_USER=membership_saas
# openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_random_hex
POSTGRES_DB=membership_saas
DB_URL_ASYNC=postgresql+asyncpg://membership_saas:CHANGE_ME_random_hex@db:5432/membership_saas
DB_URL_SYNC=postgresql+psycopg2://membership_saas:CHANGE_ME_random_hex@db:5432/membership_saas
REDIS_URL=redis://redis:6379/0

# ─── Admin auth ─────────────────────────────────────────────────
# SEED_DEFAULT_ADMIN=true — API при старте создаёт владельца из ADMIN_DEFAULT_*,
# если такого email ещё нет. Нужно ровно один раз, на первом запуске.
# После того как настоящий администратор создан, поставьте false и уберите обе
# строки ADMIN_DEFAULT_* — иначе удалённая учётка вернётся при следующем старте
# API, а пароль так и останется лежать в .env (GK-442).
# С SEED_DEFAULT_ADMIN=false обе ADMIN_DEFAULT_* не читаются и не требуются.
SEED_DEFAULT_ADMIN=true
# Если ADMIN_DEFAULT_PASSWORD оставить равным "demo1234", то в проде сервер
# откажется стартовать. Для demo-окружения выставьте ALLOW_DEFAULT_ADMIN_PASSWORD=true.
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_password
ALLOW_DEFAULT_ADMIN_PASSWORD=false

# 32+ символов случайных. openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_random_hex
# Срок жизни access-токена в минутах. По умолчанию 4 часа.
JWT_EXPIRE_MINUTES=240
# Сколько попыток логина с одного IP в минуту разрешено.
LOGIN_RATE_LIMIT_PER_MINUTE=5

# ─── CORS ──────────────────────────────────────────────────────
# По умолчанию равен ADMIN_BASE_URL. Можно перечислить через запятую.
# В проде "*" будет отклонён при старте.
CORS_ALLOWED_ORIGINS=

# ─── Public URL (для Stripe success_url и т.п.) ─────────────────
PUBLIC_BASE_URL=https://your-ip.sslip.io
ADMIN_BASE_URL=https://your-ip.sslip.io

# ─── Stripe (test mode) ─────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_6M_ID=
STRIPE_PRICE_ANNUAL_ID=
# Создайте webhook endpoint: https://your-ip.sslip.io/webhooks/stripe
# События: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted.
# БЕЗ этого секрета webhook вернёт 400, fail-open запрещён.
STRIPE_WEBHOOK_SECRET=
# Тестовый или боевой режим определяется ТОЛЬКО префиксом STRIPE_SECRET_KEY
# (sk_test_ или sk_live_). Отдельного переключателя нет — STRIPE_TEST_MODE
# удалён в GK-436, потому что его никто не читал.
# GK-377/GK-433: отмена автопродления в Stripe (cancel_at_period_end).
# Пока false бот принимает запрос, но останавливать списание приходится
# человеку в панели Stripe — заявка попадает в очередь ручной отмены.
# ЭТА СТРОКА ОТСУТСТВОВАЛА НА СЕРВЕРЕ 16 ДНЕЙ, и всё это время кнопка
# «Отменить автопродление» молча уходила в ручную очередь (GK-436).
ENABLE_STRIPE_AUTORENEW_CANCELLATION=false

# ─── GK-486: аккаунты, которым бот не даст заплатить ─────────────
# Numeric Telegram user ids через запятую. Служебные аккаунты — Павел, Грант,
# кураторы: доступ у них уже есть, покупать им нечего, а «💎 Подписка» ведёт на
# живую оплату с реальным списанием с карты. До 24.08 единственной защитой была
# просьба «не нажимай», отправленная человеку, у которого в базе уже лежало
# пять попыток оплаты (июнь). Человек — не защитный механизм.
#
# ВНИМАНИЕ: пустое значение читается ПРОТИВОПОЛОЖНО PRELAUNCH_HOLD_ALLOWLIST.
#   Пусто в PRELAUNCH_HOLD_ALLOWLIST = никто не проходит мимо заглушки (безопасно).
#   Пусто здесь                      = никто не защищён (НЕбезопасно).
# Списки похожи и ломаются в разные стороны — не объединять и не копировать
# один в другой.
#
# Кого сюда НЕ вносить: тех, кто в allowlist именно для того, чтобы заплатить
# (GK-481). Иначе живой тест оплаты молча перестанет работать.
#
# Не привязано к ENABLE_PRELAUNCH_HOLD: защита должна пережить снятие заглушки.
# Ошибка в значении блокирует оплату ВСЕМ — это громко и чинится одной строкой,
# в отличие от тихо снятой защиты.
#   NO_CHARGE_TG_IDS=111111111,222222222
NO_CHARGE_TG_IDS=

# ─── GK-439: старт оплаченного времени с фиксированной даты ──────
# Пока здесь стоит БУДУЩАЯ дата (UTC, ISO-8601), первый оплаченный период
# любого участника начинается с неё, а не со дня оплаты: оплата 19.08 даёт
# доступ 01.09 → 01.10. Продления не затрагиваются — они и так считаются от
# expires_at.
#
# Эта же дата двигает часы Stripe: чекаут берёт первый период разовой
# позицией и переносит первое списание на конец этого периода через
# subscription_data.trial_end, поэтому дата следующего списания у провайдера
# и наш expires_at не расходятся. У Lava такого поля нет — контракт
# привязан к моменту оплаты, — так что для рублёвых оплат дата списания
# остаётся личной, а дата доступа общая. Принято сознательно (GK-439).
#
# Пусто = механизм полностью выключен, чекаут работает как сегодня.
# После запуска строку очищают — так механизм убирает сам себя.
# ACCESS_START_FLOOR=2026-09-01T00:00:00Z
ACCESS_START_FLOOR=

# ─── Lava Top (production) — keep disabled until live account verification ──
# Outgoing Lava API key. Do not confuse this with the incoming webhook secret.
LAVA_API_KEY=
# Public API v1.22.0 base URL and the verified subscription offer UUID.
LAVA_API_BASE_URL=https://gate.lava.top
LAVA_OFFER_ID=
# Legacy/unused by POST /api/v3/invoice; retained for older environments.
LAVA_SHOP_ID=
# Live checkout uses POST /api/v3/invoice and asks the buyer for an email.
ENABLE_LAVA_LIVE_CHECKOUT=false
# GK-445: there is no ENABLE_LAVA_LIVE_REFUND. Lava publishes no refund
# endpoint, so a Lava refund is always: refund it in the Lava dashboard, then
# confirm it in the admin panel. If the key is still set on a host, the config
# audit reports it as retired and it is safe to delete.
# GK-377: DELETE /api/v1/subscriptions/{id}. While false the bot still accepts
# cancellation requests and routes them to the manual queue.
ENABLE_LAVA_AUTORENEW_CANCELLATION=false
# GK-418 rollback lever — leave false. True makes RUB checkout link to the
# buyer-facing offer page instead of creating an API invoice; Lava sends no
# purchase webhook for those sales and hides them from the seller API, so the
# buyer pays and is granted nothing. Not a workaround for the "Оплатить" hang.
ENABLE_LAVA_RUB_OFFER_PAGE=false
# Incoming Lava webhook auth configured in the Lava dashboard.
# Launch default: X-Api-Key. Alternative supported mode: Basic auth.
LAVA_WEBHOOK_AUTH_MODE=api_key
LAVA_WEBHOOK_API_KEY=
LAVA_WEBHOOK_BASIC_USERNAME=
LAVA_WEBHOOK_BASIC_PASSWORD=

# ─── Реквизиты ручных платежей ──────────────────────────────────
ZELLE_RECIPIENT=membership_saas@example.com
USDT_TRC20_ADDRESS=TLotQJsvstVxCQdQNBoAUYn15ousqD75EC
USDT_ERC20_ADDRESS=0x6f4C9BfDa3446265168c6567483feDca17643fc2
USDT_TRC20_CONFIRMATIONS=3
USDT_ERC20_CONFIRMATIONS=3
# Optional explorer keys. Keep empty until rate limits require them.
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1
ETHERSCAN_API_KEY=

# ─── AI поддержка ───────────────────────────────────────────────
# Провайдер: mock | openai | anthropic
SUPPORT_AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Маршрутизация поддержки (GK-378) ───────────────────────────
# Bot-API-reachable chat the bot forwards inbound support tickets to: a curator
# group/channel chat id (e.g. -1003778334018) the bot is an admin of with
# send rights, OR an @username the bot can post to. Empty = no auto-routing —
# tickets are still persisted and answered from the admin panel (status
# `skipped`). Set this per-environment in the server .env, NOT in git.
# Staging curator chat (Grant, issue #5): -1003778334018.
SUPPORT_ROUTING_CHAT_ID=
# Optional direct contact shown in bot support copy, e.g. @GKcurators. A private
# user account cannot receive bot-initiated messages, so it is a fallback link,
# not a routing target — use SUPPORT_ROUTING_CHAT_ID for forwarding.
SUPPORT_CONTACT=

# ─── Реферальная программа ──────────────────────────────────────
# REFERRAL_BONUS_DAYS и REFERRAL_BONUS_REFEREE_DAYS удалены в GK-436: программа
# платит комиссию через ledger (решение созвона 2026-05-21), бонусных дней в коде
# не осталось, и обе переменные месяцами ничего не меняли, оставаясь при этом
# в .env сервера.
#
# GK-457. Реестр комиссий ведётся в долларах — порог выплаты $100, и так же
# написано в утверждённых текстах бота, — а основная валюта аудитории рубли.
# Здесь курс, по которому оплата пересчитывается в доллары в момент начисления:
# множитель «сколько долларов за одну единицу валюты», через запятую.
# RUB:0.0125 → тариф 1500 ₽ стоит $18.75, партнёру начисляется 20% от этой суммы.
#
# 0.0125 взято не с биржи, а из нашего же прайса: 1500 ₽/$19, 7000 ₽/$79 и
# 10000 ₽/$129 дают 0.01267, 0.01129 и 0.0129. Пересматривайте при изменении
# рублёвых цен. Применённый курс пишется в саму строку начисления
# (referral_commissions.fx_rate_to_usd) и виден в панели, так что устаревшее
# значение заметно и исправляется корректировкой, а не переписыванием истории.
#
# Валюта без курса НЕ угадывается: комиссия записывается как $0.00 с пустым
# курсом и уходит алерт в ops-чат. Пустая строка = ни одной валюты, кроме USD.
REFERRAL_FX_RATES_TO_USD=RUB:0.0125

# ─── Member portal + Vimeo (GK-091) ─────────────────────────────
# Read-only Vimeo API token (Settings → Developer → Personal access tokens,
# scopes: public, private, video_files). Stored locally in
# credentials/vimeo_api_token.txt; never commit the raw token. Empty = sync
# is skipped gracefully (existing rows keep rendering).
VIMEO_API_TOKEN=
# Public base URL of the portal — the bot puts this in magic links and the
# portal redirects here. Local: http://localhost:3001 ; prod:
# https://community.example.com
PORTAL_BASE_URL=http://localhost:3001
# Caddy site address for the portal. Prod: community.example.com.
# Defaults to portal.localhost in the Caddyfile when unset (DNS pending, BLK-014).
PORTAL_DOMAIN=community.example.com
# Magic-link single-use TTL and portal session length (sliding).
PORTAL_MAGIC_LINK_TTL_MINUTES=15
PORTAL_SESSION_DAYS=30
PORTAL_SESSION_MAX_ACTIVE=3
# Leave unset in prod (cookie is Secure/HTTPS-only). Set to "false" ONLY for
# local plain-HTTP testing on http://localhost (env goes on the portal service).
# PORTAL_COOKIE_SECURE=false

# ─── Google Sheets CRM export (GK-080) ───────────────────────────────
# Share the target spreadsheet with the service-account client_email.
# Never commit the raw service-account JSON.
#
# GK-479: prefer the inline JSON. This file used to default to the mounted
# path below, and on the live host that path was a bind mount from inside a
# release directory — so the deploy after the one that created it deleted the
# key, left the setting pointing at nothing, and the export was dead for ten
# weeks while the panel showed "Configured". `.env` is the one artefact the
# deploy workflow carries forward, so the value survives there. Paste the whole
# downloaded key file on one line; check first that it contains no `$` and no
# real newlines, both of which the env-file parser mangles.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Alternative, if a real secret manager mounts the file. Only use a path
# OUTSIDE releases/ — anything under it is deleted by the next deploy. A path
# that does not resolve is reported by `python -m app.config_audit`.
# GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=/run/secrets/membership_saas_google_sheets_service_account.json
GOOGLE_SHEETS_QUOTA_MAX_RETRIES=5

# ─── Launch feature flags (GK-120) ──────────────────────────────
# Production launch hides Zelle, webhook integrations (AmoCRM/Make/Zapier),
# and any real OpenAI/Anthropic-backed support replies until those flows
# are explicitly approved. Defaults are OFF — flip individual flags to
# true only after the corresponding integration is signed off.
#   ENABLE_ZELLE=true                    → Zelle payment option visible in bot
#   ENABLE_WEBHOOK_INTEGRATIONS=true     → admin can add AmoCRM/Make/Zapier hooks
#   ENABLE_AI_SUPPORT=true               → bot may call OpenAI/Anthropic (otherwise mock-only)
ENABLE_ZELLE=false
ENABLE_WEBHOOK_INTEGRATIONS=false
ENABLE_AI_SUPPORT=false

# ─── Outgoing webhooks ───────────────────────────────────────────
# Опциональный shared-secret. Если задан, добавляется как fallback,
# когда у конкретного webhook'а в админке секрет не задан индивидуально.
OUTGOING_WEBHOOK_SIGNING_SECRET=

# ─── Среда ──────────────────────────────────────────────────────
# dev | demo | prod
APP_ENV=demo

# ─── Observability (GK-040) ─────────────────────────────────────
# Logs: json | console. Use json in prod so Loki/Datadog/etc can ingest.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Sentry DSN — leave empty to disable. Set per-env, not in git.
SENTRY_DSN=
# Commit string sent with every Sentry event. GK-434.3: leave this EMPTY on a
# host deployed by `deploy.yml` — the workflow exports the deployed commit into
# the environment, which wins over this file, and a rollback restores the
# release it rolls back to. A value written here would pin every future event to
# whatever commit somebody typed once. Set it by hand only for a manual deploy.
SENTRY_RELEASE=
# 0.0 disables performance traces (default); raise to 0.1–0.2 in prod
# if/when we want latency profiling.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Telegram chat id for ops alerts (bot down, backup failed, scheduler stall).
# Production target is @alert_membership_community / chat id 1003722846405.
# Leave empty in local/demo to avoid spamming that channel.
ALERT_CHAT_ID=
# How stale the bot heartbeat may be before /health flips to degraded (503).
BOT_HEARTBEAT_MAX_AGE_SECONDS=180

# ─── Frontend Sentry (GK-041, Next.js admin + portal) ───────────
# Separate DSNs keep admin and portal events in their OWN Sentry projects, so
# they can be smoke-tested independently and never mix with the backend/bot
# (SENTRY_DSN above) or with each other. A Sentry DSN is a write-only ingestion
# key — exposing it to the browser is expected. Leave empty to disable Sentry
# for that frontend; the Docker build still succeeds with empty values.
# NOTE: these are read at IMAGE BUILD time (NEXT_PUBLIC_* is inlined into the
# client bundle), so changing a DSN requires `docker compose build admin portal`,
# not just a restart.
ADMIN_SENTRY_DSN=
PORTAL_SENTRY_DSN=
# Frontend events reuse APP_ENV as the Sentry `environment` tag and SENTRY_RELEASE
# as the release name (both set above) — no extra vars needed for those.
#
# Source-map upload to Sentry is OFF by default. To enable readable stack traces,
# set ALL of the following; the auth token MUST stay out of git (host .env only).
# Build ARGs land in image history, so only set the token on a trusted build host.
SENTRY_ORG=
SENTRY_ADMIN_PROJECT=
SENTRY_PORTAL_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Backups (GK-040, requires `--profile backup`) ──────────────
# age recipient pubkey. Generate with `age-keygen -o key.txt`; the public
# string (age1...) goes here, the private key stays in your secret vault.
BACKUP_AGE_PUBLIC_KEY=
# rclone remote target. See deploy/backup/rclone.example.conf for the
# rclone.conf skeleton. Live value is currently Google Drive — an INTERIM
# target, see docs/runbooks/backup_restore.md and GK-441.
#   Google Drive: gdrive:membership_saas-backups/prod
#   AWS S3:       s3:membership_saas-backups/prod
#   R2:           r2:membership_saas-backups/prod
#   B2:           b2:membership_saas-backups/prod
BACKUP_RCLONE_REMOTE=
# How long to keep local copies under /var/backups/membership_saas (in the container).
BACKUP_RETENTION_DAYS=14
# How long to keep copies on the REMOTE. Leave EMPTY on S3/R2/B2 — there a
# bucket lifecycle rule should do it, storage-side, where a bug in our script
# cannot reach the backups. Set it only for backends with no lifecycle support
# (Google Drive has none), or remote copies accumulate forever. Must be >=
# BACKUP_RETENTION_DAYS so off-host copies never expire before local ones.
BACKUP_REMOTE_RETENTION_DAYS=30
# How often to back up. 86400 = once a day.
BACKUP_INTERVAL_SECONDS=86400
# Optional: healthchecks.io-style ping URL hit on every successful run.
BACKUP_HEALTHCHECK_URL=
# Optional: webhook URL that receives a JSON {text} POST on failure.
# You normally do NOT need this — a failed backup now alerts the same Telegram
# ops chat as everything else, using BOT_TOKEN + ALERT_CHAT_ID from this file.
BACKUP_ALERT_WEBHOOK_URL=
# Host path to the rclone config holding the object-storage credentials.
# It is gitignored and must live OUTSIDE the release tree in production:
# deploy.yml rsyncs with `--delete` and carries forward only this .env, so a
# copy left in `releases/<stamp>/deploy/backup/` is deleted by the next deploy
# and backups then fail silently. On the live host:
#   BACKUP_RCLONE_CONF=/opt/membership_saas/secrets/rclone.conf
# Leave unset locally to use the gitignored deploy/backup/rclone.conf.
BACKUP_RCLONE_CONF=

# ─── Restore canary (GK-437, same `--profile backup`) ───────────
# A backup that cannot be decrypted looks exactly like a backup. On 2026-08-09
# the age private key on file failed its own checksum and every dump taken
# until then was unreadable, while the backup job reported success nightly.
# The `backup-verify` service decrypts the newest dump, restores it into a
# scratch database, compares it against live, and writes the verdict to
# `backup_verifications`. The bot alerts on failure, on staleness, and on the
# canary never having run.
#
# Host path to the age PRIVATE key. Same rule as BACKUP_RCLONE_CONF, and it
# matters more: a deleted rclone.conf can be rewritten, a lost private key
# makes every dump we hold permanently unreadable. Keep it outside `releases/`.
#   BACKUP_AGE_IDENTITY_HOST_FILE=/opt/membership_saas/secrets/age-identity.txt
# Leave unset locally to use the gitignored deploy/backup/age-identity.txt.
BACKUP_AGE_IDENTITY_HOST_FILE=
# Scratch database the dump is restored into. Dropped before and after every
# run. The script refuses to start if this equals POSTGRES_DB.
BACKUP_VERIFY_DB=membership_saas_restore_check
# A dump older than this many hours fails the check even if it restores
# perfectly — "restorable" is worth nothing if it is last week's data.
BACKUP_VERIFY_MAX_AGE_HOURS=30
# How often the canary runs, and how long it waits after container start (so a
# fresh `up -d` does not verify a dump that is still being written).
BACKUP_VERIFY_INTERVAL_SECONDS=86400
BACKUP_VERIFY_INITIAL_DELAY_SECONDS=300
# How stale the newest SUCCESSFUL verification may be before the bot says so.
# Read by the backend (not by the canary): 36h absorbs one skipped run and
# catches the second.
BACKUP_VERIFICATION_MAX_AGE_HOURS=36
